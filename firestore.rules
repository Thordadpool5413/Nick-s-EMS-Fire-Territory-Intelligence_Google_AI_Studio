rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Test collection for verifying client connectivity
    match /test/{docId} {
      allow read, write: if true;
    }

    // US Nationwide Counties Directory (Read publicly, write by authenticated accounts or batch seeds)
    match /counties/{countyFips} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }

    // EMS and Fire Department Agency Records
    match /agencies/{agencyId} {
      allow read: if true;
      allow write: if true;
    }

    // Field Visit Notes and Interaction Logs
    match /field_notes/{noteId} {
      allow read: if true;
      allow write: if true;
    }

    // Global Territory Preferences & User Session Locks
    match /user_preferences/{userId} {
      allow read, write: if true;
    }
  }
}
